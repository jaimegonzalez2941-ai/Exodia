# Discord Application Bot Token from Discord Developer Portal
# https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_TOKEN="YOUR_DISCORD_BOT_TOKEN_FROM_DEVELOPER_PORTAL"

# Application Client ID (General Information tab)
CLIENT_ID="YOUR_APPLICATION_CLIENT_ID"

# Target Discord Server (Guild) ID for instantaneous command registration
GUILD_ID="YOUR_DISCORD_SERVER_ID"

# Pre-computed Permissions Integer for OAuth2 Invite Link: 1101927935014
# Includes: Kick, Ban, Moderate/Timeout Members, Manage Messages, Manage Roles, Send Messages, Embed Links, Slash Commands
